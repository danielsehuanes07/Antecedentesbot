# Dominio reservado en ngrok, sin https://
NGROK_DOMAIN=tu-dominio.ngrok-free.app
NGROK_AUTHTOKEN=pega_aqui_tu_authtoken

# Genera un valor largo para proteger la comunicación n8n -> API.
INTERNAL_API_KEY=cambia-esta-clave-interna-por-otra-larga-y-aleatoria

# Colombia
GENERIC_TIMEZONE=America/Bogota
TZ=America/Bogota

# Opcional: vacío desactiva la resolución automática. Las tareas consumen saldo.
CAPSOLVER_API_KEY=
CAPSOLVER_TIMEOUT_SECONDS=120
