{
  "name": "NullTrace - Solo Antecedentes Judiciales",
  "nodes": [
    {
      "parameters": {"updates": ["message"], "additionalFields": {}},
      "id": "2a46dd31-171a-4f26-94ac-95c37b903c15",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [-800, 80]
    },
    {
      "parameters": {
        "jsCode": "const message = $input.first().json.message ?? {};\nconst text = String(message.text ?? '').trim();\nconst chatId = message.chat?.id;\nlet tipo = 'invalido';\nlet cedula = '';\nif (text === '/start' || text === '/ayuda') tipo = 'inicio';\nelse {\n  cedula = text.replace(/[.\\s-]/g, '');\n  if (/^\\d{6,10}$/.test(cedula)) tipo = 'consulta';\n}\nreturn [{ json: { tipo, cedula, chatId } }];"
      },
      "id": "ecf41aad-fb9b-49e4-b574-cb7567664666",
      "name": "Validar mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-580, 80]
    },
    {
      "parameters": {
        "rules": {"values": [
          {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3}, "conditions": [{"id": "652f3ea4-08af-476c-b7e9-d91ed6bb8424", "leftValue": "={{ $json.tipo }}", "rightValue": "inicio", "operator": {"type": "string", "operation": "equals"}}], "combinator": "and"}, "renameOutput": true, "outputKey": "inicio"},
          {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3}, "conditions": [{"id": "9eddf159-6646-4be2-baa7-afb8e74cd647", "leftValue": "={{ $json.tipo }}", "rightValue": "consulta", "operator": {"type": "string", "operation": "equals"}}], "combinator": "and"}, "renameOutput": true, "outputKey": "consulta"},
          {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3}, "conditions": [{"id": "ae852358-b45a-4376-b61c-c54c61286649", "leftValue": "={{ $json.tipo }}", "rightValue": "invalido", "operator": {"type": "string", "operation": "equals"}}], "combinator": "and"}, "renameOutput": true, "outputKey": "invalido"}
        ]},
        "options": {}
      },
      "id": "5d664675-ed70-4930-9780-d63eea2c9108",
      "name": "Tipo de mensaje",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [-350, 80]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "=⚖️ *NullTrace — Antecedentes Judiciales*\n\nEnvíame únicamente un número de cédula colombiano (6 a 10 dígitos).\n\nEjemplo: `1234567890`\n\n🔐 Consulta solo tus propios datos o datos para los que tengas autorización. El resultado proviene del portal oficial de la Policía Nacional y puede requerir que completes personalmente la verificación «No soy un robot».",
        "additionalFields": {"appendAttribution": false, "parse_mode": "Markdown"}
      },
      "id": "f4540472-dd56-4e13-8438-d90901ee6d0e",
      "name": "Mensaje de inicio",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [-60, -120]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "=🔎 Consultando el portal oficial de antecedentes judiciales…",
        "additionalFields": {"appendAttribution": false}
      },
      "id": "ecf52f90-af65-4590-bdbc-41f58abec65e",
      "name": "Mensaje de espera",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [-60, 60]
    },
    {
      "parameters": {
        "url": "=http://api:5000/consultar/antecedentes/{{ $('Validar mensaje').item.json.cedula }}",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "X-API-Key", "value": "={{ $env.INTERNAL_API_KEY }}"}]},
        "options": {"timeout": 70000}
      },
      "id": "58ac135b-c429-4676-843b-1c9be67896ef",
      "name": "Consultar antecedentes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [170, 60]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst chatId = $('Validar mensaje').first().json.chatId;\nconst cedula = $('Validar mensaje').first().json.cedula;\nconst link = data.fuente || 'https://antecedentes.policia.gov.co:7005/WebJudicial/';\nlet mensaje;\nif (data.estado === 'sin_asuntos_pendientes' || data.estado === 'no_requerido') {\n  mensaje = `⚖️ *Resultado oficial*\\n\\n🪪 Cédula: \\`${cedula}\\`\\n\\n${data.resultado}\\n\\n_Fuente: Policía Nacional de Colombia_`;\n} else if (data.estado === 'verificacion_requerida') {\n  mensaje = `🧩 *Verificación requerida*\\n\\nEl portal oficial exige completar «No soy un robot», por lo que la consulta no puede finalizarse automáticamente.\\n\\n[Completar consulta en la Policía Nacional](${link})`;\n} else {\n  mensaje = `⚠️ *Consulta no disponible*\\n\\n${data.mensaje || 'Intenta nuevamente más tarde.'}\\n\\n[Ir al portal oficial](${link})`;\n}\nreturn [{ json: { chatId, mensaje } }];"
      },
      "id": "ddcfe00e-2ba3-4e75-83da-3140e0b0070e",
      "name": "Formatear resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 60]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "={{ $json.mensaje }}",
        "additionalFields": {"appendAttribution": false, "parse_mode": "Markdown", "disable_web_page_preview": true}
      },
      "id": "246956a1-11c5-4ac0-aa30-bb452983b96f",
      "name": "Enviar resultado",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [630, 60]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "=⚠️ Formato no válido. Envía solo una cédula de 6 a 10 dígitos o escribe /ayuda.",
        "additionalFields": {"appendAttribution": false}
      },
      "id": "67be60f7-7099-47c2-b626-2a00c58cf45c",
      "name": "Formato inválido",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [-60, 250]
    }
  ],
  "connections": {
    "Telegram Trigger": {"main": [[{"node": "Validar mensaje", "type": "main", "index": 0}]]},
